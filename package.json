{
  "name": "recipe-planner-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff -f new_migration",
    "db:types": "supabase gen types typescript --local > types/database.types.ts",
    "inngest:dev": "inngest-cli@latest dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:golden": "RUN_GOLDEN=1 vitest run -c vitest.golden.config.mts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:seed": "tsx tests/scripts/seed-test-user.ts",
    "test:cleanup": "tsx tests/scripts/cleanup-test-user.ts",
    "seed:recipes": "tsx scripts/seed-recipes.ts",
    "bulk:import": "tsx scripts/bulk-import.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@azure/identity": "^4.13.1",
    "@azure/monitor-opentelemetry": "^1.19.0",
    "@azure/storage-blob": "^12.33.0",
    "@azure/web-pubsub": "^1.2.0",
    "@azure/web-pubsub-client": "^1.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.9.0",
    "@langchain/core": "^1.2.8",
    "@langchain/langgraph": "^1.4.10",
    "@langchain/openai": "^1.5.8",
    "@langfuse/core": "^5.10.1",
    "@langfuse/langchain": "^5.10.1",
    "@langfuse/otel": "^5.10.1",
    "@napi-rs/canvas": "^0.1.56",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "googleapis": "^144.0.0",
    "inngest": "^3.27.0",
    "langchain": "^1.5.9",
    "lucide-react": "^0.460.0",
    "next": "15.5.18",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.3",
    "openai": "^4.73.0",
    "pdfjs-dist": "^4.7.76",
