# =============================================================================
# PRODUCTION env for the Azure cutover — the full set the app validates at boot
# (source of truth: lib/env.ts). Copy to `.env.prod` (gitignored), fill in real
# values, then load them with scripts/seed-keyvault.sh.
#
# WHERE EACH LINE GOES:
#   [BUILD]  → GitHub Actions repo Variables (baked into the image at build time)
#   [ENV]    → Container App plain environment variables  (non-secret config)
#   [SECRET] → Azure Key Vault, referenced by the Container App (credentials)
#
# Key Vault secret names can't contain "_" — the seeder converts DATABASE_URL →
# DATABASE-URL, etc. Reference them from the Container App as Key Vault refs.
# =============================================================================

# ── Provider flags: flip the whole app onto Azure ───────────────── [ENV] ─────
AUTH_PROVIDER=entra
STORAGE_PROVIDER=azure
AI_PROVIDER=foundry

# ── Removed at the decommission (2026-10-09) ──────────────────────────────────
# AUTH_PROVIDER, STORAGE_PROVIDER, REALTIME_PROVIDER and JOBS_PROVIDER are gone.
# Each had exactly one working position once Supabase and Inngest were removed,
# and a missing one silently disabled a feature or fell back to a dead service.
# AI_PROVIDER above is the only genuine choice left.
#
# The NEXT_PUBLIC_SUPABASE_* pair is also gone. They used to be listed here as
# "STILL REQUIRED — the app THROWS at boot without them", which stopped being
# true when lib/env.ts dropped them; they were build-time GitHub repo Variables
# and those have been deleted too. So have NEXT_PUBLIC_REALTIME_PROVIDER and
# NEXT_PUBLIC_STORAGE_PROVIDER: storage and realtime each have one
# implementation, and the client now asks the server rather than reading a flag.

NEXT_PUBLIC_APP_URL=https://<prod-domain>
# Auth.js builds its sign-in redirect from this, so it must match a redirect URI
# registered on the Entra app.
AUTH_URL=https://<prod-domain>

# ── Database: Neon (pooled) ──────────────────────────────────────── [SECRET] ─
DATABASE_URL=postgresql://<user>:<password>@<neon-pooled-host>/<db>?sslmode=require

# ── Auth: Microsoft Entra External ID ──────────────────────────────────────
# AUTH_URL = the public app URL [ENV]. REQUIRED on Container Apps: behind the
# ingress, Auth.js's trustHost host-detection resolves to 0.0.0.0:3000, which
# breaks the OAuth redirect_uri. Setting AUTH_URL pins the correct callback host.
AUTH_URL=https://<prod-domain>
AUTH_SECRET=<32+ random chars — generate: openssl rand -base64 32>   # [SECRET]
AUTH_MICROSOFT_ENTRA_ID_ID=<app registration client id>
AUTH_MICROSOFT_ENTRA_ID_SECRET=<app registration client secret>
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://<tenant>.ciamlogin.com/<tenant-id>/v2.0

# ── Storage: Azure Blob (keyless via Managed Identity) ──────────────── [ENV] ─
AZURE_STORAGE_ACCOUNT=<storage-account-name>

# ── Realtime: Azure Web PubSub (keyless) ────────────────────────────── [ENV] ─
AZURE_WEBPUBSUB_ENDPOINT=https://<pubsub-name>.webpubsub.azure.com

# ── AI: Azure AI Foundry (keyless via Managed Identity) ─────────────── [ENV] ─
AZURE_FOUNDRY_ENDPOINT=https://<foundry-name>.cognitiveservices.azure.com
AZURE_FOUNDRY_DEPLOYMENT=gpt-4o-mini

# ── Background jobs: Durable Functions ──────────────────────── [ENV + SECRET] ─
FUNCTIONS_BASE_URL=https://<functions-app>.azurewebsites.net              # [ENV]
INGESTION_INTERNAL_SECRET=<shared secret — MUST match the Functions app>  # [SECRET]

# ── Misc ─────────────────────────────────────────────────────────── [ENV] ────
NODE_ENV=production
LOG_LEVEL=info
