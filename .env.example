# ----------------------------------------------------------
# Supabase
# ----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_JWT_SECRET=

# ----------------------------------------------------------
# Anthropic (active provider)
# ----------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Primary extraction model. Vision-capable, used for recipe PDFs/images and URLs.
ANTHROPIC_MODEL_VISION=claude-opus-4-7
ANTHROPIC_MODEL_TEXT=claude-opus-4-7
# Cheaper model for tagging and normalization (smaller, faster).
ANTHROPIC_MODEL_FAST=claude-haiku-4-5

# ----------------------------------------------------------
# OpenAI (legacy provider, kept on disk for reference, not wired)
# ----------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL_VISION=gpt-5.5
# OPENAI_MODEL_TEXT=gpt-5.5
# OPENAI_MODEL_FAST=gpt-5.5-mini

# ----------------------------------------------------------
# Inngest
# ----------------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# In dev, leave empty and run: npx inngest-cli@latest dev

# ----------------------------------------------------------
# Google OAuth (Drive sync)
# ----------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# ----------------------------------------------------------
# n8n (external automation - optional)
# ----------------------------------------------------------
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# ----------------------------------------------------------
# App
# ----------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info
