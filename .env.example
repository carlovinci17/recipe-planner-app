# =====================================================================
#  REFERENCE ONLY — do NOT copy this over .env.local
# =====================================================================
#  On 2026-10-04 this file was copied onto .env.local. Its placeholder
#  keys passed as "present but wrong", every page returned HTTP 500, and
#  the error pointed at a service that had already been deleted. It cost
#  a day.
#
#  To get a working local environment, run:
#
#      bash scripts/pull-local-env.sh
#
#  That pulls the real values from Azure — plain ones from the
#  recipe-planner container app, secrets from Key Vault kv-recipe-planner
#  — and applies the four local overrides that must NOT be the production
#  values. This file is only here to document what the variables are.
#
#  The authority on what is required is lib/env.ts. Almost everything is
#  optional in that schema on purpose: `next build` imports it with no
#  secrets available, so enforcement happens at first use instead.
# =====================================================================

# ---------------------------------------------------------------------
# Neon Postgres — the only database
# ---------------------------------------------------------------------
# The app reads DATABASE_URL; scripts/ read NEON_DATABASE_URL. Same
# connection, two names. Use the POOLED host (…-pooler.…neon.tech).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
NEON_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------
# Auth.js (NextAuth v5) + Microsoft Entra External ID
# ---------------------------------------------------------------------
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://TENANT.ciamlogin.com/TENANT_ID/v2.0
# Auth.js builds its sign-in redirect from AUTH_URL, so it must match a
# redirect URI registered on the Entra app or sign-in fails (AADSTS50011).
AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Azure — all keyless. Locally these resolve through your own `az login`;
# in production through the container app's managed identity.
# ---------------------------------------------------------------------
# Do NOT set AZURE_CLIENT_ID locally. In production it names the managed
# identity; on your machine it makes DefaultAzureCredential hunt for an
# identity that does not exist.
AZURE_STORAGE_ACCOUNT=
AZURE_WEBPUBSUB_ENDPOINT=https://wps-NAME.webpubsub.azure.com

# ---------------------------------------------------------------------
# Azure Durable Functions — the ingestion pipeline
# ---------------------------------------------------------------------
# Your local `func start` host. Production points at the deployed app.
FUNCTIONS_BASE_URL=http://localhost:7071
# Shared secret the app and the Functions host authenticate to each other
# with. MUST match functions/local.settings.json, or every ingestion step
# fails with 403.
INGESTION_INTERNAL_SECRET=dev-local-secret-change-me

# ---------------------------------------------------------------------
# AI — the one provider switch left after the decommission
# ---------------------------------------------------------------------
AI_PROVIDER=foundry
AZURE_FOUNDRY_ENDPOINT=https://aif-NAME.cognitiveservices.azure.com/
AZURE_FOUNDRY_DEPLOYMENT=gpt-4o-mini
# Anthropic is still used by the golden set and reachable with
# AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_VISION=claude-opus-4-7
ANTHROPIC_MODEL_TEXT=claude-opus-4-7
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
ANTHROPIC_MODEL_BULK=claude-sonnet-4-6

# ---------------------------------------------------------------------
# OpenAI — provider file kept on disk as reference, not wired
# ---------------------------------------------------------------------
# OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------
# App
# ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info
